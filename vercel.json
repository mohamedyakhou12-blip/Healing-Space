{
  "rewrites": [
    { "source": "/courses/:path*", "destination": "/" },
    { "source": "/articles/:path*", "destination": "/" },
    { "source": "/podcasts/:path*", "destination": "/" },
    { "source": "/videos/:path*", "destination": "/" },
    { "source": "/pdfs/:path*", "destination": "/" },
    { "source": "/live/:path*", "destination": "/" },
    { "source": "/coaching/:path*", "destination": "/" },
    { "source": "/login", "destination": "/" },
    { "source": "/register", "destination": "/" },
    { "source": "/forgot-password", "destination": "/" },
    { "source": "/reset-password", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" },
    { "source": "/profile", "destination": "/" },
    { "source": "/subscriptions", "destination": "/" },
    { "source": "/payment", "destination": "/" },
    { "source": "/notifications", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/images/(.*).jfif",
      "headers": [
        { "key": "Content-Type", "value": "image/jpeg" }
      ]
    }
  ]
}