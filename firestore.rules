rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Security Model ──
    // 100% of Firestore reads/writes are performed by the Next.js server
    // (Admin SDK on API routes). The Firebase client only uses Auth
    // (email/password) and never accesses Firestore directly.
    //
    // Therefore ALL document access from rules is DENIED:
    // - No public reads of users (email/phone/hash/birthday), content
    //   (published OR draft, including media URLs), site settings
    //   (including admin_access_code), subscriptions, payments, purchases,
    //   notifications, or reviews.
    // - No client writes to any collection.
    //
    // Content access control is enforced server-side by the API content
    // gate (see src/lib/api-content-gate.ts), not by Firestore rules.

    // Users — server-only (protects email, phone, password hash, birthday)
    match /users/{userId} {
      allow read, write: if false;
    }

    // Content collections — server-only (articles/podcasts/videos/pdfs are
    // gated per-subscription server-side; drafts are never exposed)
    match /courses/{courseId} {
      allow read, write: if false;
    }
    match /courseChapters/{chapterId} {
      allow read, write: if false;
    }
    match /courseLessons/{lessonId} {
      allow read, write: if false;
    }
    match /courseProgress/{progressId} {
      allow read, write: if false;
    }
    match /articles/{articleId} {
      allow read, write: if false;
    }
    match /podcasts/{podcastId} {
      allow read, write: if false;
    }
    match /videos/{videoId} {
      allow read, write: if false;
    }
    match /pdfResources/{pdfId} {
      allow read, write: if false;
    }
    match /liveSessions/{sessionId} {
      allow read, write: if false;
    }
    match /coaching/{coachingId} {
      allow read, write: if false;
    }

    // Subscriptions / payments / purchases — server-only
    match /subscriptions/{subId} {
      allow read, write: if false;
    }
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    // Reviews — server-only (submitted via API, sanitized + access-checked)
    match /reviews/{reviewId} {
      allow read, write: if false;
    }

    // Notifications — server-only
    match /notifications/{notifId} {
      allow read, write: if false;
    }

    // Site settings & sliders — server-only (protects admin_access_code)
    match /siteSettings/{settingId} {
      allow read, write: if false;
    }
    match /sliders/{sliderId} {
      allow read, write: if false;
    }
    match /homepageImages/{imageId} {
      allow read, write: if false;
    }

    // ── Deny everything not explicitly whitelisted above ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}